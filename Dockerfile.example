FROM node:24-alpine AS builder

# git 및 필수 빌드 도구 설치
RUN apk add --no-cache git bash

WORKDIR /src

COPY . .

# build-embedded 스크립트 실행 (latest-embedded 및 latest.tar.gz 생성)
ENV NODE_OPTIONS="--max-old-space-size=8192"
RUN bash scripts/build-embedded

FROM rancher/harvester:v1.8.2
WORKDIR /var/lib/harvester

# 빌더에서 생성된 v1.8.2.tar.gz를 복사하고 압축 해제
COPY --from=builder /src/dist/latest.tar.gz /tmp/v1.8.2.tar.gz

# 기존 UI 파일을 삭제하고, 새로 빌드된 UI 파일의 압축을 해제합니다.
RUN rm -rf /usr/share/harvester/harvester/fonts \
    /usr/share/harvester/harvester/img \
    /usr/share/harvester/harvester/js \
    /usr/share/harvester/harvester/favicon.ico \
    /usr/share/harvester/harvester/favicon.png \
    /usr/share/harvester/harvester/docs \
    /usr/share/harvester/harvester/index.html \
    /usr/share/harvester/harvester/loading-indicator.html && \
    tar -xzf /tmp/v1.8.2.tar.gz -C /usr/share/harvester/harvester --strip-components=2 && \
    rm /tmp/v1.8.2.tar.gz

# 원하는 favicon을 직접 덮어쓰기
COPY custom-static/favicon.ico /usr/share/harvester/harvester/favicon.ico
COPY custom-static/favicon.png /usr/share/harvester/harvester/favicon.png
COPY custom-static/favicon.png /usr/share/harvester/harvester/img/favicon.png
COPY custom-static/docs      /usr/share/harvester/harvester/docs/

# img/favicon.png 파일 하나로 favicon.*.png 및 harvester.*.png 파일들을 모두 덮어쓰기
RUN cd /usr/share/harvester/harvester/img && \
    for f in favicon.*.png; do [ "$f" != "favicon.png" ] && cp -f favicon.png "$f"; done && \
    for f in harvester.*.png; do cp -f favicon.png "$f"; done

# ==============================================================================
# GPU 모니터링 매니페스트 및 자동 적용 스크립트 설정 (Step 2 반영)
# ==============================================================================
RUN mkdir -p /var/lib/harvester/manifests
COPY manifests/harvester-gpu-monitoring-stack.yaml /var/lib/harvester/manifests/harvester-gpu-monitoring-stack.yaml
COPY custom-static/apply-gpu-monitoring.sh /usr/local/bin/apply-gpu-monitoring.sh
RUN chmod +x /usr/local/bin/apply-gpu-monitoring.sh && \
    if [ -f /usr/bin/entrypoint.sh ]; then \
        sed -i '2i /usr/local/bin/apply-gpu-monitoring.sh' /usr/bin/entrypoint.sh; \
    fi

ENV RANCHER_ENV="harvester"
